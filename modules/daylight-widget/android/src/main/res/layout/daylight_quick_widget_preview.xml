<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: `daylight_quick_widget.xml` at its default size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/daylight_widget_background_light"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="6dp">

  <ImageView
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:src="@drawable/daylight_widget_preview_quick" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="2"
    android:text="@string/daylight_quick_label"
    android:textColor="#13213A"
    android:textSize="12sp" />
</LinearLayout>
