<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows (Android 12 and later): `daylight_mood_widget.xml` at its default size
  in the light style, with the default moods. At one row high there is no room for the question.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/daylight_widget_background_light"
  android:gravity="center"
  android:orientation="horizontal"
  android:padding="8dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">
      <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/daylight_widget_preview_5" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/daylight_preview_mood_5"
        android:textColor="#475873"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">
      <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/daylight_widget_preview_4" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/daylight_preview_mood_4"
        android:textColor="#475873"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">
      <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/daylight_widget_preview_3" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/daylight_preview_mood_3"
        android:textColor="#475873"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">
      <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/daylight_widget_preview_2" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/daylight_preview_mood_2"
        android:textColor="#475873"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="vertical">
      <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/daylight_widget_preview_1" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/daylight_preview_mood_1"
        android:textColor="#475873"
        android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
