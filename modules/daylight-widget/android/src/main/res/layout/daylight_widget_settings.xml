<?xml version="1.0" encoding="utf-8"?>
<!-- Widget settings: the widget itself over the wallpaper at the top, the controls in a card at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/daylight_settings_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <FrameLayout
    android:id="@+id/daylight_settings_preview"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:importantForAccessibility="noHideDescendants" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/daylight_widget_settings_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:accessibilityHeading="true"
      android:text="@string/daylight_widget_settings_title"
      android:textAppearance="@android:style/TextAppearance.Material.Title" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/daylight_settings_opacity_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:labelFor="@+id/daylight_settings_opacity"
        android:text="@string/daylight_widget_settings_background"
        android:textAppearance="@android:style/TextAppearance.Material.Subhead" />

      <TextView
        android:id="@+id/daylight_settings_opacity_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@android:style/TextAppearance.Material.Subhead" />
    </LinearLayout>

    <SeekBar
      android:id="@+id/daylight_settings_opacity"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:max="20" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/daylight_widget_settings_colors"
      android:textAppearance="@android:style/TextAppearance.Material.Subhead" />

    <RadioGroup
      android:id="@+id/daylight_settings_style"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:orientation="vertical">

      <RadioButton
        android:id="@+id/daylight_settings_style_light"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/daylight_widget_settings_light" />

      <RadioButton
        android:id="@+id/daylight_settings_style_dark"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/daylight_widget_settings_dark" />

      <RadioButton
        android:id="@+id/daylight_settings_style_system"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/daylight_widget_settings_system" />

      <RadioButton
        android:id="@+id/daylight_settings_style_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/daylight_widget_settings_wallpaper" />
    </RadioGroup>

    <Button
      android:id="@+id/daylight_settings_done"
      style="@android:style/Widget.Material.Button.Borderless.Colored"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end"
      android:layout_marginTop="8dp"
      android:text="@string/daylight_widget_settings_done" />
  </LinearLayout>
</LinearLayout>
