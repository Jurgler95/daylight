<?xml version="1.0" encoding="utf-8"?>
<!-- The app's page: sky blue glow from the top into the pale blue background (`lib/theme/tokens.ts`), dark at night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
    android:angle="270"
    android:endColor="@color/daylight_widget_bottom"
    android:startColor="@color/daylight_widget_top" />
  <corners android:radius="@dimen/daylight_widget_radius" />
</shape>
